{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.js", "test/**/*.js", "tools/**/*.js"]
}
